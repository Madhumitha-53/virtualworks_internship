from flask import Flask, render_template_string
import sqlite3
import requests

app = Flask(__name__)

def init_db():

    conn = sqlite3.connect("quotes.db")
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS quotes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            quote TEXT,
            author TEXT
        )
    """)

    conn.commit()
    conn.close()

init_db()

HTML_PAGE = """

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Quote Generator</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .container {
            width: 700px;
            margin: 40px auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
        }

        h1, h2 {
            text-align: center;
        }

        .quote-box {
            background: #fafafa;
            border-left: 5px solid #007bff;
            padding: 20px;
            margin-top: 20px;
            border-radius: 5px;
        }

        .quote {
            font-size: 22px;
            font-style: italic;
        }

        .author {
            margin-top: 10px;
            text-align: right;
            font-weight: bold;
        }

        button {
            display: block;
            margin: 20px auto;
            padding: 12px 20px;
            background: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            font-size: 16px;
        }

        button:hover {
            background: #0056b3;
        }

        .history {
            margin-top: 30px;
        }

        .history-item {
            background: #eeeeee;
            padding: 15px;
            margin-top: 10px;
            border-radius: 5px;
        }

    </style>

</head>

<body>

    <div class="container">

        <h1>Quote Generator with History</h1>

        <form method="POST">

            <button type="submit">
                Generate Quote
            </button>

        </form>

        {% if quote %}

        <div class="quote-box">

            <div class="quote">
                "{{ quote }}"
            </div>

            <div class="author">
                - {{ author }}
            </div>

        </div>

        {% endif %}

        <div class="history">

            <h2>Quote History</h2>

            {% for item in history %}

            <div class="history-item">

                <strong>"{{ item[1] }}"</strong>

                <br><br>

                - {{ item[2] }}

            </div>

            {% endfor %}

        </div>

    </div>

</body>

</html>

"""

@app.route('/', methods=['GET', 'POST'])
def home():

    quote = None
    author = None

    if request.method == 'POST':

        response = requests.get("https://api.quotable.io/random")

        data = response.json()

        quote = data['content']
        author = data['author']

        conn = sqlite3.connect("quotes.db")
        cursor = conn.cursor()

        cursor.execute(
            "INSERT INTO quotes (quote, author) VALUES (?, ?)",
            (quote, author)
        )

        conn.commit()
        conn.close()

    conn = sqlite3.connect("quotes.db")
    cursor = conn.cursor()

    cursor.execute(
        "SELECT * FROM quotes ORDER BY id DESC"
    )

    history = cursor.fetchall()

    conn.close()

    return render_template_string(
        HTML_PAGE,
        quote=quote,
        author=author,
        history=history
    )

if __name__ == '__main__':
    app.run(debug=True)
