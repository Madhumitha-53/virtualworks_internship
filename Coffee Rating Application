from flask import Flask, render_template_string, request, redirect
import sqlite3

app = Flask(__name__)

def init_db():

    conn = sqlite3.connect("coffee.db")
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS coffees (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            votes INTEGER DEFAULT 0
        )
    """)

    # Insert default coffee items if table is empty
    cursor.execute("SELECT COUNT(*) FROM coffees")

    count = cursor.fetchone()[0]

    if count == 0:

        coffee_list = [
            ("Espresso", 0),
            ("Cappuccino", 0),
            ("Latte", 0),
            ("Mocha", 0),
            ("Americano", 0)
        ]

        cursor.executemany(
            "INSERT INTO coffees (name, votes) VALUES (?, ?)",
            coffee_list
        )

    conn.commit()
    conn.close()

init_db()
