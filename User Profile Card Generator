from flask import Flask, request, render_template_string

app = Flask(__name__)

HTML_PAGE = """

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile Card Generator</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .container {
            width: 450px;
            margin: 40px auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
        }

        input, textarea {
            width: 100%;
            padding: 10px;
            margin-top: 10px;
            font-size: 16px;
        }

        button {
            width: 100%;
            padding: 12px;
            margin-top: 15px;
            background: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 16px;
            border-radius: 5px;
        }

        button:hover {
            background: #0056b3;
        }

        .profile-card {
            margin-top: 30px;
            text-align: center;
            border: 1px solid #ddd;
            padding: 20px;
            border-radius: 10px;
            background: #fafafa;
        }

        .profile-card img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
        }

        .profile-card h2 {
            margin-top: 15px;
        }

        .profile-card p {
            color: #555;
        }

    </style>

</head>

<body>

    <div class="container">

        <h1>User Profile Card Generator</h1>

        <form method="POST">

            <input
                type="text"
                name="name"
                placeholder="Enter your name"
                required
            >

            <textarea
                name="bio"
                placeholder="Enter your bio"
                rows="4"
                required
            ></textarea>

            <input
                type="url"
                name="image_url"
                placeholder="Enter image URL"
                required
            >

            <button type="submit">
                Generate Profile Card
            </button>

        </form>

        {% if profile %}

        <div class="profile-card">

            <img src="{{ profile.image_url }}" alt="Profile Image">

            <h2>{{ profile.name }}</h2>

            <p>{{ profile.bio }}</p>

        </div>

        {% endif %}

    </div>

</body>

</html>

"""

@app.route('/', methods=['GET', 'POST'])
def home():

    profile = None

    if request.method == 'POST':

        name = request.form['name']
        bio = request.form['bio']
        image_url = request.form['image_url']

        profile = {
            "name": name,
            "bio": bio,
            "image_url": image_url
        }

    return render_template_string(
        HTML_PAGE,
        profile=profile
    )

if __name__ == '__main__':
    app.run(debug=True)
